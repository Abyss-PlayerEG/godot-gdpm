{
  "name": "GDPM",
  "description": "A dependency package manager for Godot plugins",
  "repo": "Abyss-PlayerEG/godot-gdpm",
  "source": {
    "ref": "dev",
    "templates": {
      "cdn": "https://cdn.jsdelivr.net/gh/{repo}@{ref}/docs/{version}/{lang}/{file}",
      "raw": "https://raw.githubusercontent.com/{repo}/{ref}/docs/{version}/{lang}/{file}"
    }
  },
  "versions": [
    "v0.1.0a1",
    "v0.0.6",
    "v0.0.3"
  ],
  "languages": [
    {
      "folder": "en",
      "locale": "en",
      "name": "English",
      "default": true
    },
    {
      "folder": "zh",
      "locale": "zh",
      "name": "简体中文",
      "default": false
    }
  ],
  "markdown_extensions": [
    "admonition",
    "pymdownx.details",
    "pymdownx.superfences",
    {
      "pymdownx.tabbed": {
        "alternate_style": true
      }
    },
    {
      "pymdownx.highlight": {
        "anchor_linenums": true
      }
    },
    "pymdownx.inlinehilite",
    "tables",
    "attr_list",
    "md_in_html"
  ],
  "features": [
    "navigation.tabs",
    "navigation.sections",
    "navigation.top",
    "search.suggest",
    "search.highlight",
    "content.code.copy"
  ]
}
